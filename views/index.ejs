<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PriceScope</title>
    <link rel="icon" type="image/x-icon" href="logo.png">
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <!-- Header Section -->
    <header>
        <div class="header-content">
            <div class="header-left">
                <div style="display: flex; align-items: center;">
                    <img src="logo.png" alt="PriceScope Logo" style="height: 40px; margin-right: 10px;">
                    <h1>PriceScope</h1>
                </div>
                <p>Find the best prices for your favorite mobile models</p>
            </div>
            <div class="header-right">
                <% if (user) { %>
                    <p>Welcome, <%= user.username || user.phoneNumber %>!</p>
                    <a href="/auth/logout" title="Logout" class="logout">
                        Logout
                    </a>
                    <% } else { %>
                        <!-- If not logged in, show login and signup links -->
                        <a href="/auth/login" title="Login">
                            <!-- Login Icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white"
                                class="bi bi-person-badge" viewBox="0 0 16 16">
                                <path d="M6.5 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                <path
                                    d="M4.5 0A2.5 2.5 0 0 0 2 2.5V14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2.5A2.5 2.5 0 0 0 11.5 0zM3 2.5A1.5 1.5 0 0 1 4.5 1h7A1.5 1.5 0 0 1 13 2.5v10.795a4.2 4.2 0 0 0-.776-.492C11.392 12.387 10.063 12 8 12s-3.392.387-4.224.803a4.2 4.2 0 0 0-.776.492z" />
                            </svg>
                        </a>
                        <a href="/auth/signup" title="Sign Up" style="margin-left:10px;">
                            <!-- Sign Up Icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white"
                                class="bi bi-person-plus" viewBox="0 0 16 16">
                                <path d="M8 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                <path
                                    d="M8 8a5.978 5.978 0 0 0-4.546 2.01C2.13 11.215 2 11.864 2 12.5V14h4v-1a2 2 0 0 1 4 0v1h4v-1.5c0-.636-.13-1.285-1.454-2.49A5.978 5.978 0 0 0 8 8z" />
                                <path fill-rule="evenodd"
                                    d="M13.5 5a.5.5 0 0 1 .5.5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 .5-.5z" />
                            </svg>
                        </a>
                        <% } %>
                            <!-- Dropdown Menu (optional section) -->
                            <div class="dropdown">
                                <svg class="dropdown-toggle" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                    fill="white" class="bi bi-list" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd"
                                        d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                                </svg>
                                <div class="dropdown-menu">
                                    <a href="#about">About Us</a>
                                    <a href="#services">Services</a>
                                    <a href="#contact">Contact</a>
                                </div>
                            </div>
            </div>
        </div>
    </header>

    <!-- Main Content Section -->
    <main>
        <div class="content-container">
            <h2>Search for the best prices of mobile phones!</h2>
            <form action="/deals" method="get">
                <input type="text" name="search" placeholder="e.g., iPhone 13" required>
                <button type="submit" class="search-btn">Search Deals</button>
            </form>
        </div>

        <!-- Trending Searches Section -->
        <section class="trending">
            <h2>Trending Searches</h2><br>
            <div class="trending-container">
                <div class="card">
                    <img src="iphone13.jpeg" alt="iPhone 13">
                    <div class="card-body">
                        <h5 class="card-title">iPhone 13</h5>
                        <p class="card-text">Starting from Rs.43,999</p>
                        <a href="https://www.amazon.in/Apple-iPhone-13-128GB-Blue/dp/B09G9BL5CP" class="btn btn-primary"
                            target="_blank">Click to Explore</a>
                    </div>
                </div>
                <div class="card">
                    <img src="s23.jpeg" alt="Samsung Galaxy S23">
                    <div class="card-body">
                        <h5 class="card-title">Samsung Galaxy S23</h5>
                        <p class="card-text">Starting from Rs.70,999</p>
                        <a href="/s23" class="btn btn-primary" target="_blank">Click to Explore</a>
                    </div>
                </div>
                <div class="card">
                    <img src="gp7.jpeg" alt="Google Pixel 7">
                    <div class="card-body">
                        <h5 class="card-title">Google Pixel 7</h5>
                        <p class="card-text">Starting from Rs.29,999</p>
                        <a href="https://www.amazon.in/Pxel-7a-Snow-128-RAM/dp/B0DR61K9L1" class="btn btn-primary"
                            target="_blank">Click to Explore</a>
                    </div>
                </div>
                <div class="card">
                    <img src="op11.jpeg" alt="OnePlus 11">
                    <div class="card-body">
                        <h5 class="card-title">OnePlus 11</h5>
                        <p class="card-text">Starting from Rs.56,999</p>
                        <a href="https://www.amazon.in/OnePlus-Eternal-Green-128GB-Storage/dp/B0BQJLCQD3"
                            class="btn btn-primary" target="_blank">Click to Explore</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="footer-left">
            <p style="color: white;">&copy; 2025 PriceScope. All rights reserved.</p>
        </div>
        <div class="footer-right">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menuToggle = document.querySelector(".dropdown-toggle");
            const dropdown = document.querySelector(".dropdown");

            menuToggle.addEventListener("click", function (event) {
                event.stopPropagation();
                dropdown.classList.toggle("active");
            });

            document.addEventListener("click", function (event) {
                if (!dropdown.contains(event.target)) {
                    dropdown.classList.remove("active");
                }
            });
        });
    </script>
</body>

</html>